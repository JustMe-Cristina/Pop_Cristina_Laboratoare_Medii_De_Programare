<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pop_Cristina_Lab7.AboutPage"
             Title="About">

    <VerticalStackLayout Spacing="10" Margin="10">

        <HorizontalStackLayout Spacing="10">
            <Image Source="shop_list.jpg"
                   SemanticProperties.Description="My Shopping List"
                   HeightRequest="64" />

            <Label Text="My Shopping Lists"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="End" />

            <Label Text="v1.0"
                   FontSize="22"
                   VerticalOptions="End" />
        </HorizontalStackLayout>

        <Label Text="This app will help you to manage your shopping lists" />

    </VerticalStackLayout>

</ContentPage>