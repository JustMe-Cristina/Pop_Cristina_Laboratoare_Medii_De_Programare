@page
@model Pop_Cristina_Lab2.Pages.Borrowings.DetailsModel

@{
    ViewData["Title"] = "Borrowing details";
}

<h1>Borrowing details</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">Member</dt>
    <dd class="col-sm-10">@Model.Borrowing.Member?.FullName</dd>

    <dt class="col-sm-2">Book</dt>
    <dd class="col-sm-10">@Model.Borrowing.Book?.Title</dd>

    <dt class="col-sm-2">Borrow date</dt>
    <dd class="col-sm-10">@Model.Borrowing.BorrowDate.ToShortDateString()</dd>

    <dt class="col-sm-2">Return date</dt>
    <dd class="col-sm-10">@Model.Borrowing.ReturnDate?.ToShortDateString()</dd>
</dl>

<a asp-page="./Edit" asp-route-id="@Model.Borrowing.ID" class="btn btn-primary">Edit</a>
<a asp-page="./Index" class="btn btn-secondary">Back to list</a>
