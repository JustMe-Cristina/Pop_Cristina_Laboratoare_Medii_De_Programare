@page
@model Pop_Cristina_Lab2.Pages.Authors.DetailsModel

@{
    ViewData["Title"] = "Author Details";
}

<h1>Author Details</h1>

<div>
    <h4>@Model.Author.FullName</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">First name</dt>
        <dd class="col-sm-10">@Model.Author.FirstName</dd>

        <dt class="col-sm-2">Last name</dt>
        <dd class="col-sm-10">@Model.Author.LastName</dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Author.ID" class="btn btn-warning">Edit</a>
    <a asp-page="./Index" class="btn btn-secondary">Back</a>
</div>
