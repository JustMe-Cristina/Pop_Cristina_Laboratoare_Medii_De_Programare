@page
@model Pop_Cristina_Lab2.Pages.Authors.DeleteModel

@{
    ViewData["Title"] = "Delete Author";
}

<h1>Delete Author</h1>

<h3>Are you sure you want to delete this author?</h3>
<div>
    <h4>@Model.Author.FullName</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">First name</dt>
        <dd class="col-sm-10">@Model.Author.FirstName</dd>
        <dt class="col-sm-2">Last name</dt>
        <dd class="col-sm-10">@Model.Author.LastName</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Author.ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
