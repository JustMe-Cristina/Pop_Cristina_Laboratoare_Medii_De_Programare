@page
@model Pop_Cristina_Lab2.Pages.Publishers.CreateModel

@{
    ViewData["Title"] = "Create Publisher";
}

<h1>Create Publisher</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Publisher.PublisherName" class="form-label"></label>
                <input asp-for="Publisher.PublisherName" class="form-control" />
                <span asp-validation-for="Publisher.PublisherName" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="./Index" class="btn btn-secondary">Back to list</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
