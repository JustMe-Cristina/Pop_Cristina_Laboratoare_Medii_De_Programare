@page
@model Pop_Cristina_Lab2.Pages.Publishers.DetailsModel

@{
    ViewData["Title"] = "Publisher details";
}

<h1>Publisher details</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">
        @Model.Publisher.PublisherName
    </dd>
</dl>

<a asp-page="./Edit" asp-route-id="@Model.Publisher.ID" class="btn btn-primary">Edit</a>
<a asp-page="./Index" class="btn btn-secondary">Back to list</a>
