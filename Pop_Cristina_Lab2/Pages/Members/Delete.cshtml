@page
@model Pop_Cristina_Lab2.Pages.Members.DeleteModel

@{
    ViewData["Title"] = "Delete Member";
}

<h1>Delete Member</h1>
<hr />

<h4>Are you sure you want to delete this member?</h4>
<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Member.FullName</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Member.Email</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Member.ID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>
