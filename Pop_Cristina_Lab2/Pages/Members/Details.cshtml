@page
@model Pop_Cristina_Lab2.Pages.Members.DetailsModel

@{
    ViewData["Title"] = "Member details";
}

<h1>Member details</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Member.FullName</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Member.Email</dd>
</dl>

<a asp-page="./Edit" asp-route-id="@Model.Member.ID" class="btn btn-primary">Edit</a>
<a asp-page="./Index" class="btn btn-secondary">Back to list</a>
