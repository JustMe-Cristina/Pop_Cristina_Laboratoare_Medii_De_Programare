@page
@model Pop_Cristina_Lab2.Pages.Books.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Book details</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Book.Title</dd>

    <dt class="col-sm-2">Author</dt>
    <dd class="col-sm-10">@Model.Book.Author?.FullName</dd>

    <dt class="col-sm-2">
        Publisher
    </dt>
    <dd class="col-sm-10">
        @Model.Book.Publisher?.PublisherName
    </dd>


    <dt class="col-sm-2">Price</dt>
    <dd class="col-sm-10">@Model.Book.Price</dd>

    <dt class="col-sm-2">Publishing date</dt>
    <dd class="col-sm-10">@Model.Book.PublishingDate.ToShortDateString()</dd>
</dl>

<a asp-page="./Edit" asp-route-id="@Model.Book.ID" class="btn btn-primary">Edit</a>
<a asp-page="./Index" class="btn btn-secondary">Back to list</a>
