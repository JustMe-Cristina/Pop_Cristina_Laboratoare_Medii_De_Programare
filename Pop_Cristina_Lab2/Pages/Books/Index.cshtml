@page
@model Pop_Cristina_Lab2.Pages.Books.IndexModel
@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<form method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="SearchString">Search by title</label>
            <input type="text" name="SearchString" value="@Model.SearchString" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="PublisherID">Publisher</label>
            <select name="PublisherID" class="form-select" asp-items="Model.Publishers">
                <option value="">All</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label d-block">&nbsp;</label>
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-page="./Index" class="btn btn-secondary">Reset</a>
        </div>
    </div>
</form>

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                <a asp-page="./Index" asp-route-SortOrder="title_desc" class="text-decoration-none">
                    Title
                </a>
            </th>
            <th>Author</th>
            <th>
                Price
                <a asp-page="./Index" asp-route-SortOrder="price_asc" class="text-decoration-none">↑</a>
                <a asp-page="./Index" asp-route-SortOrder="price_desc" class="text-decoration-none">↓</a>
            </th>
            <th>Publishing Date</th>
            <th>Publisher</th>
            <th>Categories</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Book)
        {
            <tr>
                <td>@item.Title</td>
                <td>@(item.Author?.FullName ?? "")</td>
                <td>@item.Price</td>
                <td>@item.PublishingDate.ToShortDateString()</td>
                <td>@item.Publisher?.Name</td>
                <td>
                    @if (item.BookCategories != null && item.BookCategories.Any())
                    {
                        @string.Join(", ", item.BookCategories.Select(bc => bc.Category.CategoryName))
                    }
                    else
                    {
                        <em>none</em>
                    }
                </td>
                <td>
                    <a asp-page="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info">Details</a>
                    <a asp-page="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
