@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold">Welcome to the Library of the Heart</h1>
    <p class="lead text-muted mb-4">
        A peaceful corner for book lovers — explore stories, authors, publishers, and categories that shape our literary world.
    </p>

    <div class="d-flex justify-content-center gap-3">
        <a asp-page="/Books/Index" class="btn btn-primary btn-lg px-4">Browse Books</a>
        <a asp-page="/Authors/Index" class="btn btn-outline-secondary btn-lg px-4">Meet Authors</a>
        <a asp-page="/Publishers/Index" class="btn btn-outline-secondary btn-lg px-4">Publishers</a>
        <a asp-page="/Categories/Index" class="btn btn-outline-secondary btn-lg px-4">Categories</a>
    </div>

    <div class="mt-5">
        <p class="text-secondary">
            “A room without books is like a body without a soul.” — Cicero
        </p>
    </div>
</div>
